# 8. Top-K Accuracy Evaluation
# ============================================================

test_cases = [
    {
        "occasion": "festive",
        "mood": "bold",
        "color": "black",
        "expected": "saree_005"
    },
    {
        "occasion": "wedding",
        "mood": "elegant",
        "color": "white",
        "expected": "saree_001"
    },
    {
        "occasion": "festive",
        "mood": "elegant",
        "color": "blue",
        "expected": "saree_003"
    },
    {
        "occasion": "wedding",
        "mood": "rich",
        "color": "maroon",
        "expected": "saree_002"
    },
    {
        "occasion": "formal",
        "mood": "royal",
        "color": "gold",
        "expected": "saree_004"
    }
]

top_k = 3
correct = 0

evaluation_results = []

for i, test in enumerate(test_cases):
    results = recommend_sarees_cv_dominant(
        user_occasion=test["occasion"],
        user_mood=test["mood"],
        user_color=test["color"],
        top_k=top_k
    )

    recommended_ids = results["item_id"].tolist()
    success = test["expected"] in recommended_ids

    if success:
        correct += 1

    evaluation_results.append({
        "test_case": i + 1,
        "occasion": test["occasion"],
        "mood": test["mood"],
        "color": test["color"],
        "expected": test["expected"],
        "recommended_top_k": recommended_ids,
        "success": success
    })

accuracy = (correct / len(test_cases)) * 100

eval_df = pd.DataFrame(evaluation_results)

display(eval_df)

print("\n================================")
print(f"Top-{top_k} Accuracy: {accuracy:.2f}%")
print("================================")


