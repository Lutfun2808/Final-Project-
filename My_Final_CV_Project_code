# ============================================================
# 4. CV-Dominant Mood Scoring
# ============================================================

def cv_dominant_mood_score(user_mood, brightness, texture):
    user_mood = user_mood.lower().strip()
    score = 0

    # Happy / festive: bright + detailed
    if user_mood in ["happy", "festive", "cheerful"]:
        score += brightness / 255 * 6
        score += min(texture / 80, 1) * 4

    # Calm / soft / elegant: balanced brightness + lower texture
    elif user_mood in ["calm", "soft", "relaxed", "elegant"]:
        brightness_score = 6 - abs(brightness - 150) / 25
        texture_score = 4 - texture / 20

        score += max(brightness_score, 0)
        score += max(texture_score, 0)

    # Bold / rich / royal / glamorous: darker + more textured
    elif user_mood in ["bold", "rich", "royal", "glamorous"]:
        darkness_score = (255 - brightness) / 255 * 6
        texture_score = min(texture / 80, 1) * 4

        score += darkness_score
        score += texture_score

    return score


# In[6]:


# ============================================================
# 5. CV-Dominant Recommendation Function
# ============================================================

def recommend_sarees_cv_dominant(user_occasion="", user_mood="", user_color="", top_k=3):
    user_occasion = user_occasion.lower().strip()
    user_mood = user_mood.lower().strip()
    user_color = user_color.lower().strip()

    final_scores = []
    cv_scores = []
    metadata_scores = []
    brightness_values = []
    texture_values = []

    for _, row in df.iterrows():
        item_id = row["item_id"]

        # -----------------------------
        # CV score: main score
        # -----------------------------
        if item_id in features_dict:
            brightness = features_dict[item_id]["brightness"]
            texture = features_dict[item_id]["texture"]
            cv_score = cv_dominant_mood_score(user_mood, brightness, texture)
        else:
            brightness = 0
            texture = 0
            cv_score = 0

        # -----------------------------
        # Metadata score: small bonus
        # -----------------------------
        metadata_score = 0

        if user_occasion and user_occasion in row["occasion"]:
            metadata_score += 1.5

        if user_mood and user_mood in row["mood"]:
            metadata_score += 1.0

        if user_color and user_color in row["primary_color"]:
            metadata_score += 1.0

        if user_color and user_color in row["secondary_color"]:
            metadata_score += 0.5

        if user_mood and user_mood in row["style"]:
            metadata_score += 0.5

        # -----------------------------
        # Final score
        # CV = 75%, metadata = 25%
        # -----------------------------
        final_score = (0.75 * cv_score) + (0.25 * metadata_score)

        final_scores.append(round(final_score, 3))
        cv_scores.append(round(cv_score, 3))
        metadata_scores.append(round(metadata_score, 3))
        brightness_values.append(round(brightness, 2))
        texture_values.append(round(texture, 2))

    result = df.copy()
    result["brightness"] = brightness_values
    result["texture"] = texture_values
    result["cv_score"] = cv_scores
    result["metadata_score"] = metadata_scores
    result["final_score"] = final_scores

    result = result[result["final_score"] > 0]
    result = result.sort_values(by="final_score", ascending=False)

    return result.head(top_k)


