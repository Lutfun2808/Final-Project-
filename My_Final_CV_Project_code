def show_recommendations_cv(results):
    if results.empty:
        print("No matching saree found.")
        return

    print("Recommended Sarees:")

    display(results[[
        "item_id",
        "primary_color",
        "secondary_color",
        "style",
        "transparency",
        "occasion",
        "mood",
        "brightness",
        "texture",
        "cv_score",
        "metadata_score",
        "final_score"
    ]])

    for _, row in results.iterrows():
        image_path = row["image_main"]

        print("\n-------------------------------------")
        print("Item ID:", row["item_id"])
        print("Primary Color:", row["primary_color"])
        print("Secondary Color:", row["secondary_color"])
        print("Style:", row["style"])
        print("Transparency:", row["transparency"])
        print("Occasion:", row["occasion"])
        print("Mood:", row["mood"])
        print("Brightness:", row["brightness"])
        print("Texture:", row["texture"])
        print("CV Score:", row["cv_score"])
        print("Metadata Score:", row["metadata_score"])
        print("Final Score:", row["final_score"])

        if os.path.exists(image_path):
            img = Image.open(image_path)

            plt.figure(figsize=(4, 5))
            plt.imshow(img)
            plt.axis("off")
            plt.title(row["item_id"])
            plt.show()
        else:
            print("Image not found:", image_path)


